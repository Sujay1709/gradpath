      "transparent": true,
      "description": "",
      "options": {
        "mode": "html",
        "content": "<div><h1 style=\"font-size:30px;line-height:1.2;margin:2px 0 4px;font-weight:700;\">Help & Methodology</h1><p style=\"font-size:15px;opacity:0.8;margin:0;max-width:75ch;\">How to use GradPath, where the numbers come from, and what they cannot tell you.</p></div>",
        "code": {
          "language": "plaintext",
          "showLineNumbers": false,
          "showMiniMap": false
        }
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 2,
        "w": 24,
